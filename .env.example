# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_BID_PRODUCT_ID=
# Optional: point at the test environment (https://test.dodopayments.com)
# DODO_API_BASE=https://live.dodopayments.com

# Datafast analytics
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=
DATAFAST_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://24hrs.lol

# Optional — outbid / winner emails. Skipped entirely when unset.
RESEND_API_KEY=
RESEND_FROM=24hrs.lol <bids@24hrs.lol>

# Hourly rollover cron (Vercel sends this as a bearer token automatically)
CRON_SECRET=

# Password for /admin. Leave unset to keep the dashboard disabled.
ADMIN_PASSWORD=
